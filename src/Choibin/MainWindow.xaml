<Window x:Class="Choibin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ちょい便 — 近くのPCとスマホにすぐ送る"
        Icon="app.ico"
        Height="720" Width="1080" MinHeight="620" MinWidth="1000"
        SizeToContent="WidthAndHeight"
        Background="{StaticResource PaperBrush}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>

        <Style x:Key="PeerItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="4,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDF4FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AirDrop と同じく、相手は丸いアイコンで並べます。 -->
        <DataTemplate x:Key="PeerTemplate">
            <StackPanel Width="86">
                <Grid Width="62" Height="62" HorizontalAlignment="Center">
                    <Ellipse Fill="{StaticResource AvatarBrush}"/>
                    <Ellipse Stroke="White" StrokeThickness="1.5" Opacity="0.35"/>
                    <TextBlock Text="{Binding Initial}" Foreground="White"
                               FontSize="25" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Address}" Style="{StaticResource Mono}" FontSize="10"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TransferTemplate">
            <Border Background="Transparent" Padding="0,8" Margin="0,0,0,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="{Binding Direction}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12.5"
                                   Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding LockGlyph}" FontSize="11"
                                   Margin="6,0,0,0" ToolTip="{Binding SecurityText}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding StateText}" Style="{StaticResource Mono}"
                                   FontSize="11" Margin="8,0,0,0"/>
                    </Grid>
                    <ProgressBar Grid.Row="1" Height="3" Minimum="0" Maximum="100"
                                 Value="{Binding Percent, Mode=OneWay}"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource EdgeBrush}"
                                 BorderThickness="0" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Text="{Binding Detail}" Style="{StaticResource Mono}"
                               FontSize="10.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="CHOIBIN" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="ちょい便" Style="{StaticResource H1}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="このPCの名前" Style="{StaticResource Hint}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="DeviceNameBox" Width="180" VerticalAlignment="Center"
                         LostFocus="DeviceNameBox_LostFocus"/>
            </StackPanel>
        </Grid>

        <!-- 本体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 近くのデバイス -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="近くのデバイス" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="PeerCountText" Text="探しています…" Style="{StaticResource Hint}"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <!-- AirDrop の「電波が広がる」表現。探している間だけ外側が脈打ちます。 -->
                        <Grid x:Name="Radar" IsHitTestVisible="False" VerticalAlignment="Center">
                            <Ellipse Width="130" Height="130" Stroke="{StaticResource RingBrush}"
                                     StrokeThickness="1" HorizontalAlignment="Center"/>
                            <Ellipse Width="240" Height="240" Stroke="{StaticResource RingBrush}"
                                     StrokeThickness="1" HorizontalAlignment="Center" Opacity="0.7"/>
                            <Ellipse x:Name="RadarOuter" Width="350" Height="350"
                                     Stroke="{StaticResource RingBrush}" StrokeThickness="1"
                                     HorizontalAlignment="Center" Opacity="0.45"/>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="RadarOuter"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.12" To="0.6" Duration="0:0:1.8"
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>

                        <ListBox x:Name="PeerList"
                                 BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource PeerItem}"
                                 ItemTemplate="{StaticResource PeerTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>

                    <Button Grid.Row="2" Content="もう一度探す" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="Refresh_Click"/>
                </Grid>
            </Border>

            <!-- 送るファイルと履歴 -->
            <Grid Grid.Column="1" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="送るファイル" Style="{StaticResource H2}"/>
                        <TextBlock Text="ここにドロップするか、下のボタンで選んでください。"
                                   Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                        <Grid x:Name="DropZone" Height="96" AllowDrop="True"
                              Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                              DragLeave="DropZone_DragLeave" MouseLeftButtonUp="DropZone_Click"
                              Cursor="Hand" Background="Transparent">
                            <Rectangle x:Name="DropRect" RadiusX="10" RadiusY="10"
                                       Fill="#F7FAFF"
                                       Stroke="{StaticResource RingBrush}"
                                       StrokeThickness="1.5" StrokeDashArray="4 3"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="DropText" Text="ファイルをドロップ" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="クリックして選ぶこともできます" Style="{StaticResource Hint}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="StagedList" MaxHeight="120" BorderThickness="0"
                                 Background="Transparent" Margin="0,10,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Margin="0,2"
                                               Foreground="{StaticResource InkBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="SendButton" Content="選んだデバイスへ送る"
                                    Style="{StaticResource PrimaryButton}" Click="Send_Click"/>
                            <Button Content="スマホに公開" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="Share_Click"/>
                            <Button Content="リストを空にする" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="ClearStaged_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="やりとりの記録" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="EmptyHistoryText" Text="まだ何も送受信していません。"
                                       Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TransferList" ItemTemplate="{StaticResource TransferTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- スマホ連携と設定 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="スマホ・タブレットから" Style="{StaticResource H2}"/>
                        <TextBlock Text="同じWi-Fiにつないで、このQRコードを読み取ってください。iPhoneでもアプリは要りません。"
                                   Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                        <Border Background="White" BorderBrush="{StaticResource EdgeBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12"
                                HorizontalAlignment="Center">
                            <Image x:Name="QrImage" Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   SnapsToDevicePixels="True" MinWidth="180" MinHeight="180"/>
                        </Border>

                        <TextBlock x:Name="UrlText" Style="{StaticResource Mono}" FontSize="12.5"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock x:Name="ShareStatusText" Style="{StaticResource Hint}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <Border Height="1" Background="{StaticResource EdgeBrush}" Margin="0,16,0,12"/>

                        <TextBlock Text="設定" Style="{StaticResource H2}"/>
                        <CheckBox x:Name="PhoneAccessCheck" Content="スマホからの接続を受け付ける"
                                  Checked="PhoneAccess_Changed" Unchecked="PhoneAccess_Changed"/>
                        <CheckBox x:Name="AutoAcceptCheck" Content="確認せずに自動で受け取る"
                                  Checked="AutoAccept_Changed" Unchecked="AutoAccept_Changed"/>

                        <TextBlock Text="セキュリティ" Style="{StaticResource H2}" Margin="0,16,0,4"/>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8"
                                Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🔒 PC間の転送は常に暗号化されます"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Text="接続ごとに鍵を作り直すECDH P-256と、改ざんも検出できるAES-256-GCMを使います。切ることはできません。"
                                           Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="VerifyCodeCheck" Content="送信前に確認コードを見比べる"
                                  Checked="VerifyCode_Changed" Unchecked="VerifyCode_Changed"/>
                        <CheckBox x:Name="HttpsCheck" Content="スマホとの通信もHTTPSにする"
                                  Checked="Https_Changed" Unchecked="Https_Changed" Margin="0,2,0,0"/>
                        <TextBlock Text="自己署名の証明書を使うため、スマホのブラウザーが初回に警告を出します。「詳細」から進んでください。"
                                   Style="{StaticResource Hint}" Margin="24,2,0,0"/>

                        <TextBlock Text="受信フォルダ" Style="{StaticResource H2}" Margin="0,16,0,4"/>
                        <TextBlock x:Name="SaveFolderText" Style="{StaticResource Mono}" FontSize="11"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="開く" Style="{StaticResource GhostButton}" Click="OpenFolder_Click"/>
                            <Button Content="変更" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="ChangeFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</Window>
